# Okta OIDC configuration
# Create an OIDC Web Application in your Okta Admin Console and fill in the values below.
OKTA_DOMAIN=your-okta-domain.okta.com
OKTA_CLIENT_ID=your-client-id
OKTA_CLIENT_SECRET=your-client-secret

# The base URL of this application (used for the OAuth2 callback and logout redirect)
APP_BASE_URL=http://localhost:3000

# Express session secret – use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Server port (optional, defaults to 3000)
PORT=3000

# Set to "production" in production environments
NODE_ENV=development
